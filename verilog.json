{
    "Comment: Question": {
        "prefix": "comment",
        "body": [
            "/* Problem statement: $1",
            "* $2",
            "*/",
            "$0"
        ],
        "description": "Comment to printed on the top of the solution files for describing the problem the statements"
    },
    "Instantiation_no_params": {
        "prefix": "module_no_param",
        "body": [
            "${1:module_name} ${2: instance_name} (",
            "    $3",
            ");$0"
        ],
        "description": "Instantiate a module with no parameters"
    },
    "multiple line assign statement": {
        "prefix": "assign_multi_line",
        "body": [
            "assign ${1:output} = (",
            "    $2",
            ");$0"
        ],
        "description": "Instantiate a module with no parameters"
    },
    "Top module with no params": {
        "prefix": "top_module_no_params",
        "body": [
            "module top_module",
            "(",
            "    //output(s)",
            "    output ${1}",
            "",
            "    //input(s)",
            "    input ${2}",
            ");",
            "",
            "    ${0: description...}",
            "",
            "endmodule",
        ],
        "description": "Instantiate a module with no parameters"
    },
}